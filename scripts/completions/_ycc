#compdef ycc
# zsh completion for ycc (install.sh) — install: ycc completion --shell zsh --install

# _ycc_mcps — managed MCP servers, from 'ycc list-mcps' for the --target on the line.
_ycc_mcps() {
    local targets="all" i
    for (( i = 1; i < CURRENT; i++ )); do
        [[ "${words[i]}" == "--target" ]] && targets="${words[i+1]}"
    done
    local -a servers
    servers=(${(f)"$(${_ycc_cmd} list-mcps --target "${targets}" 2>/dev/null)"})
    (( ${#servers} )) && _values -s , 'MCP server' "${servers[@]}"
}

_ycc() {
    local _ycc_cmd="${words[1]}"
    local -a common
    common=(
        '--target[targets to sync]:targets:_values -s , target claude cursor codex opencode agents omp all'
        '--skills-home[resolve duplicate skills]:dir:(agents native)'
        '(--global)--project[write into the current project]'
        '(--project)--global[write into user-global config]'
        '--force[let repo values win]'
        '--dry-run[preview omp calls without writing (omp only)]'
        '--help[show help]'
    )
    local mode='--mode[marketplace source mode]:mode:(local repo)'
    local intent='--intent[what to sync]:intents:_values -s , intent base skills agents commands settings rules mcp hooks plugins mods'
    local mcps='--mcps[only these managed MCP servers]:servers:_ycc_mcps'
    local only='--only[run only these steps]:steps:_values -s , step base skills agents commands settings rules mcp hooks mods'
    local package='--package[install package closures]:packages:_values -s , package ycc ycc-mcp ycc-hooks ycc-rules'

    if (( CURRENT == 2 )); then
        local -a subcommands
        subcommands=(
            'install:initial setup (base + opt-in steps)'
            'sync:sync intents to targets'
            'remove:remove installer-managed config'
            'migrate:preview or apply native package migration'
            'cli:link install.sh onto PATH as ycc'
            'completion:print or install shell completion'
            'list-mcps:list the managed MCP servers'
        )
        _describe -t commands 'ycc command' subcommands
        return
    fi

    # Hand _arguments the words after the subcommand.
    local sub="${words[2]}"
    shift words
    (( CURRENT-- ))
    case "${sub}" in
        migrate)
            _arguments '--target[migration targets]:targets:_values -s , target claude codex cursor omp all' \
                '--apply[apply the migration (default: dry-run)]' \
                '--marketplace-source[eligible native Codex marketplace]:directory:_directories' '--help[show help]'
            ;;
        cli)
            _arguments '--dir[install directory]:directory:_directories' '--force[replace existing]' '--help[show help]'
            ;;
        list-mcps)
            _arguments '--target[targets to list for]:targets:_values -s , target claude cursor codex opencode agents omp all' '--help[show help]'
            ;;
        completion)
            _arguments '--shell[shell]:shell:(bash zsh fish)' '--install[install for the shell]' '--force[replace existing]' '--help[show help]'
            ;;
        install)
            _arguments "${common[@]}" "${mode}" "${package}" "${only}" "${mcps}" \
                '--settings[also merge settings]' '--rules[also link rules]' \
                '--mcp[also merge MCP servers]' '--hooks[also link hooks]'
            ;;
        sync)
            _arguments "${common[@]}" "${mode}" "${intent}" "${mcps}"
            ;;
        remove)
            _arguments "${common[@]}" "${only}" "${intent}" "${mcps}"
            ;;
    esac
}

if [[ "${funcstack[1]}" == "_ycc" ]]; then
    _ycc "$@"
else
    compdef _ycc ycc
fi
