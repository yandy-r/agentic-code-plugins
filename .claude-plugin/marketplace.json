{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "ycc",
  "description": "Yandy's Claude Code plugin bundle, consolidated under the ycc: namespace.",
  "owner": {
    "name": "yandy-r"
  },
  "metadata": {
    "version": "6.0.0",
    "repository": "https://github.com/yandy-r/ystack"
  },
  "plugins": [
    {
      "name": "ycc",
      "description": "Yandy's Claude Code plugin bundle: planning, implementation, git workflow, research, docs, orchestration, and project utilities — all under the ycc: namespace.",
      "version": "6.0.0",
      "author": {
        "name": "yandy-r"
      },
      "source": "./ycc"
    },
    {
      "name": "ycc-mcp",
      "description": "Native MCP-only plugin per runtime.",
      "version": "6.0.0",
      "author": {
        "name": "yandy-r"
      },
      "source": "./packages/claude/ycc-mcp"
    },
    {
      "name": "ycc-hooks",
      "description": "Native ycc hooks plugin.",
      "version": "6.0.0",
      "author": {
        "name": "yandy-r"
      },
      "source": "./packages/claude/ycc-hooks"
    },
    {
      "name": "ycc-all",
      "description": "Meta plugin that installs ycc, ycc-mcp, and ycc-hooks together.",
      "version": "6.0.0",
      "author": {
        "name": "yandy-r"
      },
      "source": "./packages/claude/ycc-all"
    }
  ]
}
